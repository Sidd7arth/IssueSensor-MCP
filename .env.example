# Absolute path to the repository ReproMCP is authorized to inspect.
REPROMCP_WORKSPACE=C:\\path\\to\\repromcp\\demo_repo

# Test execution is intentionally disabled by default.
# Only enable this for a repository whose test code you trust.
REPROMCP_ALLOW_TEST_EXECUTION=false

# Preferred hackathon path: multimodal Gemma 4 through the Gemini API.
AI_PROVIDER=gemma
GEMINI_API_KEY=replace-with-your-key-do-not-commit
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional offline/text-only fallback: set AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
